# ========================================================
# GARIHA — Environment Variables Configuration
# ========================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Required in production on Vercel. Works with Neon, Supabase, Vercel Postgres, AWS RDS, etc.
# Format: postgres://username:password@host:port/database?sslmode=require
DATABASE_URL=postgres://user:password@host.pooler.supabase.com:6543/postgres?sslmode=require

# 2. AUTHENTICATION & SECURITY
# Secret key used to sign and verify session JWTs. Must be a strong random string (e.g. 32+ characters).
JWT_SECRET=your_long_random_jwt_secret_key_here

# 3. INITIAL ADMINISTRATOR
# Email of the platform administrator. Users registered with this email are automatically granted Super Admin status.
ADMIN_EMAIL=admin@gariha.com
# Optional initial password used by `npm run setup-db` or POST /api/setup to bootstrap the initial admin:
ADMIN_INITIAL_PASSWORD=your_secure_admin_initial_password_here

# 4. OPTIONAL: GOOGLE OAUTH
# If Google Sign-In is enabled:
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 5. OPTIONAL: PRODUCTION SETUP PROTECTION
# Protects the /api/setup and /api/setup/seed endpoints in production:
SETUP_SECRET=your_custom_setup_secret_token
